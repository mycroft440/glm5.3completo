# GLM-5.3 complete server configuration
# ACCELERATOR_PROFILE is resolved by install.sh. Use auto, rocm, or nvidia.
ACCELERATOR_PROFILE=auto

MODEL_ID=zai-org/GLM-5.3
MODEL_REVISION=187fb9fff6319062325ff825627ef6db084d9bc6
SERVED_MODEL_NAME=glm-5.3

# Reproducible base images. install.sh selects one and writes VLLM_BASE_IMAGE.
NVIDIA_VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:2286e8533ca8b6bc777594bae30524f1426ba46ca21797524e06df6a94b06635
ROCM_VLLM_BASE_IMAGE=vllm/vllm-openai-rocm@sha256:e0a3b2bd3fe7ec563916c3a5d949898d133458c18d6b2f460c906885cfb32032
VLLM_BASE_IMAGE=auto
VLLM_IMAGE=auto
VLLM_DOCKERFILE=auto
NGINX_IMAGE=nginx@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de

# NVIDIA/H200-only build pins. Ignored by the ROCm profile.
VLLM_SOURCE_REF=2cf0a6915ce544dc493a0990f2ea38d81601128a
DEEPGEMM_REF=8b1392b978f5a03c828dd1711090d7fb50958b8a
VLLM_ENABLE_CUDA_COMPATIBILITY=auto

TENSOR_PARALLEL_SIZE=8
EXPECTED_GPUS=8
STRICT_GPU_COUNT=1
EXPECTED_GPU_NAME_REGEX=auto
EXPECTED_GPU_ARCH=auto
MIN_GPU_MEMORY_MIB=auto
MIN_HOST_RAM_GIB=1400
REQUIRE_FABRIC_MANAGER=auto

# Profile defaults are written by install.sh:
# MI300X/ROCm: 524288 context, 32 seqs, 0.80 utilization, fp8_e4m3, AITER.
# H200/NVIDIA: 131072 context, 8 seqs, 0.90 utilization, fp8, DeepGEMM.
MAX_MODEL_LEN=auto
MAX_NUM_SEQS=auto
MAX_NUM_BATCHED_TOKENS=auto
GPU_MEMORY_UTILIZATION=auto
KV_CACHE_DTYPE=auto
MTP_SPECULATIVE_TOKENS=5

API_PORT=8000
BIND_ADDRESS=127.0.0.1
HF_CACHE_DIR=/var/lib/glm53-full/huggingface
VLLM_CACHE_DIR=/var/lib/glm53-full/vllm-cache
DEEPGEMM_CACHE_DIR=/var/lib/glm53-full/deepgemm-cache
MIN_FREE_DISK_GIB=1200
MIN_DOCKER_FREE_DISK_GIB=100
MIN_VLLM_CACHE_FREE_DISK_GIB=30
MIN_DEEPGEMM_CACHE_FREE_DISK_GIB=20
VLLM_ENGINE_READY_TIMEOUT_S=7200

API_KEY=CHANGE_ME
HF_TOKEN=
ALLOWED_MEDIA_DOMAIN=media.invalid
VLLM_MEDIA_URL_ALLOW_REDIRECTS=0
