ARG VLLM_BASE_IMAGE=vllm/vllm-openai-rocm@sha256:e0a3b2bd3fe7ec563916c3a5d949898d133458c18d6b2f460c906885cfb32032
FROM ${VLLM_BASE_IMAGE}

USER root

COPY scripts/patch_vllm_agent_compat.py /tmp/patch_vllm_agent_compat.py
RUN python3 /tmp/patch_vllm_agent_compat.py --self-test \
    && python3 /tmp/patch_vllm_agent_compat.py \
    && rm -f /tmp/patch_vllm_agent_compat.py

# AITER detects the native gfx architecture during import, so importing it while
# building on a CPU-only CI runner is expected to fail. Verify that ROCm/vLLM
# are present and that the AITER package exists; the installer later imports
# AITER with /dev/kfd and the real MI300X devices attached.
RUN python3 -c "import importlib.util, torch, vllm; assert torch.version.hip; assert importlib.util.find_spec('aiter') is not None; print('ROCm', torch.version.hip, 'vLLM', vllm.__version__, 'AITER package OK')"
